APP_NAME="Fakultas Kopi Photobooth API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fakultas_kopi_photobooth
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@fakultaskopi.com"
MAIL_FROM_NAME="Fakultas Kopi Photobooth"

FILESYSTEM_DISK=local
STORAGE_DRIVER=local

SESSION_DURATION_MINUTES=10
GALLERY_EXPIRY_DAYS=30
MAX_PHOTOS_PER_SESSION=10
GALLERY_BASE_URL=https://gallery.fakultaskopi.com
PRINTER_NAME=default
PRINTER_TIMEOUT=30

# Cloudflare R2 (production only)
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
